# SQL Server connection.
DB_SERVER=192.168.9.75
DB_DATABASE=SRH
DB_USER=sa
DB_PASSWORD=your-password
DB_PORT=1433

BACKEND_PORT=6001
FRONTEND_PORT=6002
BASE_PATH=/
VITE_API_BASE_URL=http://localhost:6001

# Local development only: bypass login screen and use a local admin token.
BYPASS_LOGIN=false
VITE_BYPASS_LOGIN=false

# Google Calendar / Meet integration.
# Uses one shared Google account. Create OAuth credentials, authorize the account once,
# and place the refresh token here. Leave blank to disable Google sync.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
GOOGLE_CALENDAR_TIMEZONE=Asia/Kolkata
GOOGLE_DEFAULT_EVENT_DURATION_MINUTES=30

# Google Chat Space incoming webhook URL. Create it from the target Space's
# Apps & integrations menu. Leave blank to disable Space notifications.
GOOGLE_CHAT_WEBHOOK_URL=
